---
import FaqArticlePage from '../../../components/FaqArticlePage.astro';
import { seoFaqs, type FaqItem } from '../../../data/site';

export function getStaticPaths() {
	return seoFaqs.map((faq) => ({
		params: { slug: faq.slug },
		props: { faq },
	}));
}

const { faq } = Astro.props as { faq: FaqItem };
---

<FaqArticlePage locale="en" faq={faq} />
