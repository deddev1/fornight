---
import ReviewArticlePage from '../../../components/ReviewArticlePage.astro';
import { customerReviews, type CustomerReview } from '../../../data/site';

export function getStaticPaths() {
	return customerReviews.map((review) => ({
		params: { slug: review.slug },
		props: { review },
	}));
}

const { review } = Astro.props as { review: CustomerReview };
---

<ReviewArticlePage locale="en" review={review} />
